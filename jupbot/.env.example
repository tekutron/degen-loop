# RPC for cycle + SDK tools
SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Cycle configuration
SIZE_SOL=0.01
SLIPPAGE_BPS=300
TAKE_PROFIT_PCT=12
STOP_LOSS_PCT=10
PRICE_POLL_MS=10000
TRENDING_REFRESH_MS=600000

# 0x (ZeroEx) API (optional)
# ZEROX_API_KEY=your_key_here
ZEROX_BASE=https://api.0x.org/swap/solana
ZEROX_REGION=us

# Jupiter API key (optional but recommended - get from https://station.jup.ag/api-keys)
# JUPITER_API_KEY=your_key_here

# Prefer skipping preflight for fast fills
SKIP_PREFLIGHT=1

# Confirm use of funded wallet
MAIN_WALLET=1

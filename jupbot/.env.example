# RPC for cycle + SDK tools (Helius recommended for reliability)
SOLANA_RPC=https://api.mainnet-beta.solana.com
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Cycle configuration
# NOTE: Jupiter Ultra API requires minimum ~0.05 SOL trade size
SIZE_SOL=0.05
SLIPPAGE_BPS=300
TAKE_PROFIT_PCT=12
STOP_LOSS_PCT=10
PRICE_POLL_MS=10000
TRENDING_REFRESH_MS=60000

# 0x (ZeroEx) API (optional - additional liquidity source)
ZEROX_API_KEY=your_0x_api_key_here
ZEROX_BASE=https://api.0x.org/swap/solana
ZEROX_REGION=us

# Jupiter API key (REQUIRED - get from https://portal.jup.ag)
# Ultra Swap API requires authentication
JUPITER_API_KEY=your_jupiter_api_key_here

# Prefer skipping preflight for fast fills
SKIP_PREFLIGHT=1

# Confirm use of funded wallet (safety check for liquidateAll)
MAIN_WALLET=1

# Wallet path
SWAP_WALLET=./wallets/generated_keypair.json

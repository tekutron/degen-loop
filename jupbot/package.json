  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "^0.2.32-alpha",
    "@solana/spl-token": "0.3.11",
    "@solana/web3.js": "^1.95.3",
    "axios": "^1.6.8",
    "bn.js": "^5.2.1"
  }
}

{
  "name": "jupbot",
  "version": "2.0.0",
  "description": "Solana trading bot using Raydium pools and Jupiter Ultra Swap API",
  "main": "degenCycle.mjs",
  "scripts": {
    "start": "node degenCycle.mjs",
    "bot": "node degenCycle.mjs",
    "check": "node checkWallet.mjs",
    "test-swap": "node testSwap.mjs",
    "liquidate": "MAIN_WALLET=1 node liquidateAll.mjs",
    "unwrap": "node unwrapSol.mjs",
    "swap:raydium": "node raydiumSwap.js",
    "swap:sdk": "node sdkSwap.js",
    "trade:scan": "node tradeBot.mjs",
    "trade:execute": "node executeProposal.mjs",
    "trade:sell": "node executeSellProposal.mjs",
    "trade:monitor": "node monitorExit.mjs",
    "trade:loop": "node tradeLoop.mjs"
  },
  "keywords": [
    "solana",
    "trading-bot",
    "raydium",
    "jupiter",
    "dex",
    "automated-trading"
  ],
  "author": "",
